{
  "name": "yinyun-windows",
  "version": "1.0.3",
  "description": "连接音云服务器的 Windows 音乐播放器，支持排行榜、本地下载、收藏、歌单和数据同步恢复",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "npm test && electron-builder --win --x64 --arm64 --publish never",
    "dist:x64": "npm test && electron-builder --win --x64 --publish never",
    "dist:arm64": "npm test && electron-builder --win --arm64 --publish never"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bobcc4/yinyun-windows.git"
  },
  "author": {
    "name": "bobcc4",
    "email": "bobcc4@users.noreply.github.com"
  },
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/bobcc4/yinyun-windows/issues"
  },
  "homepage": "https://github.com/bobcc4/yinyun-windows#readme",
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "lucide": "^1.28.0"
  }
}
